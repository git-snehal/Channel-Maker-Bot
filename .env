# Copy this file to .env and fill in your values.
# Get API_ID / API_HASH from https://my.telegram.org -> API development tools

API_ID=
API_HASH=

# Session file name (no extension). Change only if you want multiple sessions.
SESSION_NAME=anime_channel_bot

# Your numeric Telegram user id. Leave blank for the first run --
# the bot will print it on login so you can copy it in here and restart.
OWNER_ID=

TARGET_GROUP=

# Delay range (seconds) between each channel creation.
MIN_DELAY=30
MAX_DELAY=60

# Longer cooldown break after this many channels in a row.
COOLDOWN_EVERY=8
COOLDOWN_MIN=300
COOLDOWN_MAX=600
